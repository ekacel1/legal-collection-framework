{
  "manifestVersion": 1,
  "id": "bj.sgg",
  "name": "SGG Benin Document Collector",
  "version": "0.1.0",
  "apiVersion": "^1.0",
  "entry": "./dist/src/index.js",
  "license": "Apache-2.0",
  "maintainers": ["montes.virgile@gmail.com"],

  "source": {
    "displayName": "Secretariat General du Gouvernement",
    "homepage": "https://sgg.gouv.bj",
    "jurisdictionHint": "opaque-to-kernel",
    "languages": ["fr"]
  },

  "capabilities": {
    "network": {
      "allowedHosts": ["sgg.gouv.bj"],
      "maxRequestsPerMinute": 20,
      "politenessDelayMs": 1500,
      "respectRobotsTxt": true,
      "maxConcurrentPerHost": 1
    },
    "browser": false,
    "inlineContent": false
  },

  "schedule": {
    "defaultCron": "0 2 * * *",
    "timezone": "Africa/Porto-Novo",
    "maxConcurrentDownloads": 1
  },

  "configSchema": {
    "type": "object",
    "properties": {
      "category": {
        "type": "string",
        "enum": ["lois", "decrets", "ordonnances", "arretes", "accords", "decisions"]
      },
      "baseUrl": { "type": "string", "pattern": "^https?://" },
      "maxPages": { "type": "integer", "minimum": 1 }
    },
    "required": ["category"],
    "additionalProperties": false
  },

  "secrets": [],

  "integrity": {
    "expectedMimeTypes": ["application/pdf"],
    "minDocumentBytes": 1024,
    "maxDocumentBytes": 209715200
  },

  "conformance": {
    "kitVersion": "1.0",
    "fixturesPath": "./test/fixtures"
  }
}
